{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.worker-test.tsbuildinfo",
    "target": "ES2022",
    "lib": ["ES2022"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "types": [
      "vitest/globals",
      "@cloudflare/vitest-pool-workers/types",
      "@cloudflare/workers-types"
    ]
  },
  "include": ["test-worker/**/*.ts", "worker-configuration.d.ts"]
}
